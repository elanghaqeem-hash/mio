{
  "name": "mio-v2-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run release:preflight && npm run build:web",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop-renderer": "tsc -b && vite build --mode electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run release:preflight && npm run build:desktop-renderer && npm run build:electron",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "pack:win": "npm run build:all && electron-builder --win --dir",
    "dist:win": "npm run build:all && electron-builder --win",
    "training:export": "tsx scripts/training/export-training-bundle.ts",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:deployment-contract": "node scripts/deployment-contract-check.mjs",
    "release:promotion-selftest": "node scripts/promotion-readiness-selftest.mjs",
    "release:promotion-gate": "node scripts/rc-promotion-gate.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "release:check": "npm run release:preflight && npm run release:animation-v1 && npm run release:deployment-contract && npm run release:promotion-selftest && npm run build:all && npm run release:smoke && npm run release:manifest",
    "test": "npm run release:deployment-contract && npm run release:promotion-selftest && npm run release:smoke && npm run release:manifest && node --import tsx src/tests/runAllTests.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "release:animation-v1": "node scripts/animation-v1-release-check.mjs",
    "deploy:verify:animation": "node scripts/verify-animation-deployment.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mio.v2.desktop",
    "productName": "Mio V2",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "training",
        "to": "training",
        "filter": [
          "train_mio_lora.py",
          "sft_lora.py",
          "requirements.txt",
          "configs/**/*"
        ]
      },
      {
        "from": "scripts/training/create-training-run-handoff.mjs",
        "to": "scripts/training/create-training-run-handoff.mjs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mio V2"
    }
  }
}
