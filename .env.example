# Public build metadata. These values are safe to expose in the Web Lab bundle.
VITE_MIO_RELEASE_VERSION=1.0.0
VITE_MIO_RELEASE_CHANNEL=technology-preview
VITE_MIO_RELEASE_SHA=local
VITE_MIO_DEPLOYMENT_ID=local

# Cloudflare Pages Function metadata. Do not put API keys or secrets in this file.
MIO_RELEASE_VERSION=1.0.0
MIO_RELEASE_CHANNEL=technology-preview
MIO_RELEASE_SHA=unknown
MIO_DEPLOYMENT_ID=unknown

# Server-side provider configuration names only. Configure actual secret values in the deployment platform.
OPENROUTER_MODEL=
# OPENROUTER_API_KEY must be configured as a secret in Cloudflare/hosting settings; never commit it here.
OPENAI_MODEL=
# OPENAI_API_KEY must be configured as a secret in Cloudflare/hosting settings; never commit it here.

# Mio Voice V4.4 production synthesis gateway. Never prefix these with VITE_.
# MIO_TTS_ENDPOINT must be an HTTPS endpoint for a separately licensed/consented/project-owned TTS voice.
MIO_TTS_ENDPOINT=
MIO_TTS_VOICE_ID=
MIO_TTS_MODEL=
# MIO_TTS_API_KEY must be configured as a Cloudflare/hosting secret; never commit it here.
# Optional additional trusted application origins, comma-separated. Same-origin requests are always accepted.
MIO_VOICE_ALLOWED_ORIGINS=
# Optional transitional gateway token. Configure as a deployment secret and do NOT ship it as a static browser value.
# Public production should replace this boundary with application-session authentication plus distributed rate limiting.
# MIO_VOICE_GATEWAY_TOKEN=

# Mio Voice V4.4 verified session boundary.
# Set true only after one of the verification paths below is configured.
MIO_VOICE_REQUIRE_SESSION=false

# Cloudflare Access verification path.
# TEAM_DOMAIN must be an HTTPS Access team domain, for example https://your-team.cloudflareaccess.com
# AUD is the Access Application Audience (AUD) tag. The gateway verifies signature, issuer, audience and expiry.
MIO_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
MIO_CLOUDFLARE_ACCESS_AUD=

# Alternative trusted Mio middleware path.
# Configure MIO_VOICE_TRUSTED_SUBJECT_TOKEN as a deployment secret, never as VITE_ or browser-visible config.
# Trusted middleware must strip browser-supplied x-mio-authenticated-subject* headers and inject:
#   x-mio-authenticated-subject
#   x-mio-authenticated-subject-token
# MIO_VOICE_TRUSTED_SUBJECT_TOKEN=
