# Public build metadata. These values are safe to expose in the Web Lab bundle.
VITE_MIO_RELEASE_VERSION=1.0.0
VITE_MIO_RELEASE_CHANNEL=technology-preview
VITE_MIO_RELEASE_SHA=local
VITE_MIO_DEPLOYMENT_ID=local

# Cloudflare Pages Function metadata. Do not put API keys or secrets in this file.
MIO_RELEASE_VERSION=1.0.0
MIO_RELEASE_CHANNEL=technology-preview
MIO_RELEASE_SHA=unknown
MIO_DEPLOYMENT_ID=unknown

# Server-side provider configuration names only. Configure actual secret values in the deployment platform.
OPENROUTER_MODEL=
# OPENROUTER_API_KEY must be configured as a secret in Cloudflare/hosting settings; never commit it here.
OPENAI_MODEL=
# OPENAI_API_KEY must be configured as a secret in Cloudflare/hosting settings; never commit it here.

# Mio Voice V4 production synthesis gateway. Never prefix these with VITE_.
# MIO_TTS_ENDPOINT is the licensed TTS service endpoint called only by the server-side Pages Function.
MIO_TTS_ENDPOINT=
MIO_TTS_VOICE_ID=
MIO_TTS_MODEL=
# MIO_TTS_API_KEY must be configured as a Cloudflare/hosting secret; never commit it here.
